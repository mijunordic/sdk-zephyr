# Configuration options for the nrf GPIO 1-Wire Master driver

# Copyright (c) 2026, Nordic Semiconductor ASA 
# SPDX-License-Identifier: Apache-2.0

config W1_NRF_GPIO
	bool "1-wire GPIO"
	default y
	depends on DT_HAS_W1_NRF_GPIO_ENABLED
	help
	  This option enables the nrf GPIO 1-Wire master driver.

	  The bus reset, and bit read and write operations are executed
	  via byte read and write operations on top of the nrf
	  GPIO driver interface.

if W1_NRF_GPIO

config W1_NRF_GPIO_TIME_CRITICAL
	bool "Force time critical operations"
	default y
	help
	  This option forces the 1-Wire GPIO driver to use time critical
	  operations for bus reset, and bit read and write operations.
	  Time critical communications operations are not interrupted while
	  being generated.

endif # W1_NRF_GPIO
