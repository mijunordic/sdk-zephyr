/ {
	w1_uart: w1-nrf-gpio {
		compatible = "w1,nrf-gpio";
		gpios = <&gpio1 3 (GPIO_ACTIVE_HIGH | GPIO_OPEN_DRAIN)>;
		status = "okay";

		#address-cells = <1>;
		#size-cells = <0>;

		ds18b20_a: ds18b20@0 {
			compatible = "maxim,ds18b20";
			reg = <0>;
			resolution = <12>;
			status = "okay";
		};
	};
};