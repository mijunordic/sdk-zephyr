#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
&pinctrl {
    uart21_default: uart21_default {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 3)>,
                    <NRF_PSEL(UART_RX, 1, 3)>;
            nordic,drive-mode = <NRF_DRIVE_S0D1>;
        };
    };
    uart21_sleep: uart21_sleep {
        group1 {
            psels = <NRF_PSEL(UART_TX, 1, 3)>,
                    <NRF_PSEL(UART_RX, 1, 3)>;
            low-power-enable;
        };
    };
};
&uart21 {
    status = "okay";

    w1_uart: w1-bus {
        compatible = "zephyr,w1-serial";
        status = "okay";
        #address-cells = <1>;
        #size-cells = <0>;

        ds18b20_a: ds18b20@0 {
            compatible = "maxim,ds18b20";
            reg = <0>;
            resolution = <12>;
            status = "okay";
        };
    };
};